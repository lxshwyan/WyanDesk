{
  "manifest_version": 3,
  "minimum_chrome_version": "116",
  "name": "微言桌面 WyanDesk",
  "version": "0.5.0",
  "description": "把微言桌面设为新标签页，快速收藏网页，并将当前窗口批量整理到网站组合。",
  "permissions": ["activeTab", "storage", "identity", "contextMenus"],
  "background": { "service_worker": "background.js", "type": "module" },
  "optional_permissions": ["tabs", "bookmarks"],
  "host_permissions": ["https://wyanhub.com/*", "https://desk.wyanhub.com/*"],
  "action": {
    "default_title": "收藏到微言桌面",
    "default_popup": "popup.html"
  },
  "chrome_url_overrides": {
    "newtab": "app/index.html"
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
