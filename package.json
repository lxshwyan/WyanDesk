{
  "name": "wyan-desk",
  "private": true,
  "version": "0.6.2",
  "description": "Local-first browser desktop for bookmarks, tasks, notes, schedules, focus sessions and reminders.",
  "license": "MIT",
  "homepage": "https://desk.wyanhub.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/lxshwyan/WyanDesk.git"
  },
  "bugs": {
    "url": "https://github.com/lxshwyan/WyanDesk/issues"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "keywords": [
    "startpage",
    "dashboard",
    "new-tab",
    "pwa",
    "bookmarks",
    "productivity"
  ],
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build && node scripts/inject-pwa-assets.mjs && node scripts/validate-seo.mjs",
    "build:extension": "npm run build && node scripts/build-extension.mjs",
    "validate:extension": "node scripts/validate-extension.mjs",
    "validate:pwa": "node scripts/validate-pwa.mjs",
    "validate:seo": "node scripts/validate-seo.mjs",
    "package:extension": "npm run build:extension && npm run validate:extension && sh scripts/package-extension.sh",
    "test": "vitest run",
    "typecheck": "tsc --noEmit --pretty false"
  },
  "dependencies": {
    "lucide-react": "1.52.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "typescript": "7.0.2",
    "vite": "8.3.2",
    "vitest": "4.1.11"
  }
}
